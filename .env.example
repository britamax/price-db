# Database credentials
POSTGRES_DB=pricedb
POSTGRES_USER=price_admin
POSTGRES_PASSWORD=changeme_use_strong_random_password

# App admin auth (HTTP basic)
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=changeme_use_strong_random_password

# App secrets (generate via: openssl rand -hex 32)
APP_SECRET_KEY=changeme_random_32chars
SESSION_SECRET=changeme_random_64chars_hex

# Embedding server (Ollama local on host)
# Inside Docker, host.docker.internal points to the VM/host running Docker
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
EMBEDDING_MODEL=nomic-embed-text
